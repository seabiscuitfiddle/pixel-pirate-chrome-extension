#!/bin/sh
# Bump the minor version in manifest.json (and reset patch) on every commit.
manifest="manifest.json"

version=$(sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([0-9]*\)\.\([0-9]*\)\.\([0-9]*\)".*/\1.\2.\3/p' "$manifest")
if [ -z "$version" ]; then
  echo "pre-commit: could not find version in $manifest" >&2
  exit 1
fi

major=${version%%.*}
rest=${version#*.}
minor=${rest%%.*}
new="$major.$((minor + 1)).0"

sed -i.bak "s/\(\"version\":[[:space:]]*\"\)$version\"/\1$new\"/" "$manifest" && rm -f "$manifest.bak"
git add "$manifest"
echo "pre-commit: version $version -> $new"
